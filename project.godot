; Engine configuration file.
; veggie-arena - portrait phone arena survival roguelite
; NOTE: keep every comment in this file ASCII-only. Godot's ConfigFile parser can
; merge a non-ASCII comment into the NEXT key name (observed once: the key became
; "<comment text>window/dpi/allow_hidpi"), which silently disabled the setting -
; the file looked correct while the runtime happily used the engine default.
; scripts/check.sh step 1.8 reads the critical values back, so it cannot happen
; again unnoticed.
config_version=5

[application]

config/name="veggie-arena"
config/description="手机竖屏竞技场生存 Roguelite"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/main_scene="res://ui/Screens/Main.tscn"

; Clear color matches the kitchen floor (dark charcoal) so the arena never looks
; like a black frame with grey borders around it.
[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.052, 0.066, 1)

[autoload]

Art="*res://autoload/Art.gd"
Data="*res://autoload/Data.gd"
Events="*res://autoload/Events.gd"
GameState="*res://autoload/GameState.gd"
Settings="*res://autoload/Settings.gd"
Steam="*res://autoload/Steam.gd"
SaveMgr="*res://autoload/SaveMgr.gd"
Sfx="*res://autoload/Sfx.gd"
Bgm="*res://autoload/Bgm.gd"
Gamepad="*res://autoload/Gamepad.gd"
I18n="*res://autoload/I18n.gd"
HudLayout="*res://ui/HUD/HudLayout.gd"
ScreenMode="*res://ui/Screens/ScreenMode.gd"
Perf="*res://autoload/Perf.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=900
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; HiDPI is ON: text renders at native phone resolution (blurry-text fix).
; Fill-rate cost is capped at DPR 2 by the DPR-CAP-JS patch in scripts/bust_cache.sh;
; combined with the HitSpark pool + physics interpolation this stays within budget.
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[gui]

theme/custom_font="res://fonts/NotoSansSC-Subset.otf"

[physics]

; 60Hz fixed-step simulation + render interpolation. Without it, a 120Hz screen
; draws the same physics step twice in a row, so everything appears to move in
; discrete hops: average fps looks perfect, the game still feels rough (industry
; calls this "judder"). Cost: visuals lag one physics step (<=16.7ms); hit
; detection stays in the physics step and is unaffected.
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[preset.0]

name="Web"
platform="Web"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="web/build/index.html"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
variant/extensions_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=false
html/export_icon=true
html/custom_html_shell=""
html/head_include=""
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=false
progressive_web_app/enabled=false
progressive_web_app/ensure_cross_origin_isolated_headers=false
progressive_web_app/display=1
progressive_web_app/background_color=#ffffff
progressive_web_app/icon_144x144=""
progressive_web_app/icon_180x180=""
progressive_web_app/icon_512x512=""
progressive_web_app/apple_touch_icon=""
