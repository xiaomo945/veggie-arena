; Engine configuration file.
; veggie-arena —— 手机竖屏竞技场生存 Roguelite
config_version=5

[application]

config/name="veggie-arena"
config/description="手机竖屏竞技场生存 Roguelite"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/main_scene="res://ui/Screens/Main.tscn"

; 战场外的清屏色与灶台地板统一（深炭），避免"黑底+灰边"的割裂感
[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.052, 0.066, 1)

[autoload]

Art="*res://autoload/Art.gd"
Data="*res://autoload/Data.gd"
Events="*res://autoload/Events.gd"
GameState="*res://autoload/GameState.gd"
Settings="*res://autoload/Settings.gd"
Steam="*res://autoload/Steam.gd"
SaveMgr="*res://autoload/SaveMgr.gd"
Sfx="*res://autoload/Sfx.gd"
Bgm="*res://autoload/Bgm.gd"
Gamepad="*res://autoload/Gamepad.gd"
I18n="*res://autoload/I18n.gd"
HudLayout="*res://ui/HUD/HudLayout.gd"
ScreenMode="*res://ui/Screens/ScreenMode.gd"
Perf="*res://autoload/Perf.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=900
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
# 手机 DPR 常常是 2~3，开 HiDPI 等于每帧要画 1179x2619 个像素（填充率直接吃掉帧率）。
# 2D 像素风/矢量风在 DPR=1 下观感差别极小，帧率收益很大 —— 怪多时从 29 帧往 60 帧靠。
window/dpi/allow_hidpi=false

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[gui]

theme/custom_font="res://fonts/NotoSansSC-Subset.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[preset.0]

name="Web"
platform="Web"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="web/build/index.html"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release=""
variant/extensions_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=false
html/export_icon=true
html/custom_html_shell=""
html/head_include=""
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=false
progressive_web_app/enabled=false
progressive_web_app/ensure_cross_origin_isolated_headers=false
progressive_web_app/display=1
progressive_web_app/background_color=#ffffff
progressive_web_app/icon_144x144=""
progressive_web_app/icon_180x180=""
progressive_web_app/icon_512x512=""
progressive_web_app/apple_touch_icon=""
