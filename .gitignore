# Godot
.godot/
*.tmp
export.cfg
export_credentials.cfg
.import/
mono_crash.*.json

# 导出产物（体积大，不进 git）
# 注意：build2/build3 这类临时目录也要挡掉，否则只传上去 index.js 而 wasm 被挡，
# 结果是仓库里躺着一堆跑不起来的残件
web/build*/
*.zip
*.pck
*.wasm

# 系统
.DS_Store
Thumbs.db

# Godot/系统崩溃转储（core.<pid>，体积可达 GB 级，绝不进 git）
# 注意：只忽略带扩展名的转储文件，绝不能写裸的 "core" —— 否则会把源码目录 core/ 一起忽略
core.*
*.core

# 本地密钥（绝不提交）
*.token
.env

# Python 缓存
__pycache__/
*.pyc
